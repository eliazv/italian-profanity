{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eliazv/italian-profanity/data/schema/fixture.schema.json",
  "title": "Caso di test (una riga JSONL)",
  "description": "Vedi SPECIFICHE.md §7.1. Almeno uno tra action, rules e mustNotMatch.",
  "type": "object",
  "required": ["id", "input", "profile"],
  "additionalProperties": false,
  "anyOf": [
    { "required": ["action"] },
    { "required": ["rules"] },
    { "required": ["mustNotMatch"] }
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*-[0-9]{3,}$" },
    "input": { "type": "string" },
    "profile": { "enum": ["balanced", "strict", "lenient"] },
    "contacts": { "type": "boolean" },
    "action": { "enum": ["allow", "review", "block"] },
    "rules": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "mustNotMatch": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "note": { "type": "string" }
  }
}
