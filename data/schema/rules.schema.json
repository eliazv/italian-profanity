{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eliazv/italian-profanity/data/schema/rules.schema.json",
  "title": "File di regole",
  "description": "Regole lessicali. Vedi SPECIFICHE.md §5.",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "term": {
      "description": "Termine già normalizzato: minuscole a-z, senza accenti, senza lettere ripetute 3+ volte.",
      "type": "string",
      "pattern": "^[a-z]+$",
      "minLength": 2
    },
    "terms": {
      "type": "array",
      "items": { "$ref": "#/$defs/term" },
      "minItems": 1,
      "uniqueItems": true
    },
    "base": {
      "type": "object",
      "required": ["id", "kind", "category", "severity", "confidence", "provenance"],
      "properties": {
        "id": {
          "description": "Stabile: compare nei risultati e nei changelog. Formato lingua.categoria.nome.",
          "type": "string",
          "pattern": "^(it|en)\\.(blasphemy|insult|sexual|discriminatory|vulgar)\\.[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "category": {
          "enum": ["blasphemy", "insult", "sexual", "discriminatory", "vulgar"]
        },
        "severity": { "description": "1 lieve · 2 volgare · 3 grave", "enum": [1, 2, 3] },
        "confidence": { "enum": ["high", "medium"] },
        "provenance": {
          "description": "Origine del dato: manual oppure fonte@commit registrata in data/sources.json. Solo per i curatori.",
          "type": "array",
          "items": { "type": "string", "pattern": "^(manual|[a-z0-9-]+@[0-9a-f]{7,40})$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "note": { "description": "Solo per i curatori: non finisce nei pacchetti.", "type": "string" }
      }
    },
    "rule": {
      "oneOf": [
        {
          "description": "Parola intera uguale a una delle forme elencate.",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "type": "object",
          "required": ["terms"],
          "unevaluatedProperties": false,
          "properties": { "kind": { "const": "word" }, "terms": { "$ref": "#/$defs/terms" } }
        },
        {
          "description": "Parola che inizia con il termine. Raro: richiede una nota di giustificazione.",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "type": "object",
          "required": ["terms", "note"],
          "unevaluatedProperties": false,
          "properties": { "kind": { "const": "prefix" }, "terms": { "$ref": "#/$defs/terms" } }
        },
        {
          "description": "Sequenza di parole intere.",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "type": "object",
          "required": ["phrases"],
          "unevaluatedProperties": false,
          "properties": {
            "kind": { "const": "phrase" },
            "phrases": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 2,
                "items": { "$ref": "#/$defs/term" }
              }
            }
          }
        },
        {
          "description": "Composto noto dentro una sola parola, ancorato all'inizio e/o alla fine.",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "type": "object",
          "required": ["terms", "anchor"],
          "unevaluatedProperties": false,
          "properties": {
            "kind": { "const": "compound" },
            "terms": { "$ref": "#/$defs/terms" },
            "anchor": { "enum": ["start", "end", "both"] }
          }
        },
        {
          "description": "Bestemmie: concetto divino (a) adiacente a un insulto (b). Vedi SPECIFICHE.md §5.2.",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "type": "object",
          "required": ["a", "b"],
          "unevaluatedProperties": false,
          "properties": {
            "kind": { "const": "combo" },
            "a": { "$ref": "#/$defs/terms" },
            "b": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "forms": { "$ref": "#/$defs/terms" },
                "prefixes": { "$ref": "#/$defs/terms" }
              }
            }
          }
        }
      ]
    }
  }
}
