{
  "name": "italian-profanity-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "node tools/validate.ts",
    "build:data": "node tools/build.ts",
    "build": "pnpm build:data && pnpm --filter italian-profanity build",
    "test": "pnpm test:js && pnpm test:dart",
    "test:js": "pnpm --filter italian-profanity test",
    "test:dart": "cd packages/dart && dart test",
    "parity": "node tools/parity.ts",
    "audit:benign": "node tools/audit-benign.ts",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter italian-profanity typecheck",
    "lint": "biome check . && node tools/format-dart.ts && cd packages/dart && dart analyze --fatal-infos",
    "format": "biome check --write . && node tools/format-dart.ts --write",
    "check": "pnpm validate && pnpm build:data && pnpm lint && pnpm typecheck && pnpm test && pnpm parity --expectations && pnpm audit:benign",
    "changeset": "changeset",
    "release:version": "changeset version && node tools/sync-version.ts && pnpm build:data"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^6.0.3"
  }
}
