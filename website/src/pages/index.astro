---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Workflows from "../components/Workflows.astro";
import Installation from "../components/Installation.astro";
import { faq } from "../data/faq";
import { absoluteUrl, AUTHOR, HOME_DESCRIPTION, NPM_URL, PUB_URL, REPOSITORY, SITE_NAME } from "../data/site";

const home = absoluteUrl();
const license = "https://opensource.org/licenses/MIT";
const jsonLd = [
  { "@type": "WebSite", "@id": `${home}#website`, url: home, name: SITE_NAME, inLanguage: "en", publisher: AUTHOR },
  {
    "@type": "SoftwareApplication",
    "@id": `${home}#software`,
    name: SITE_NAME,
    alternateName: ["italian_profanity", "Italian profanity filter"],
    description: HOME_DESCRIPTION,
    url: home,
    applicationCategory: "DeveloperApplication",
    applicationSubCategory: "Content moderation library",
    operatingSystem: "Cross-platform (Node.js, browsers, Dart, Flutter)",
    offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
    license,
    isAccessibleForFree: true,
    author: AUTHOR,
    downloadUrl: NPM_URL,
    sameAs: [REPOSITORY, NPM_URL, PUB_URL],
    keywords: "italian profanity filter, bestemmie, parolacce, insulti, username moderation, nickname filter, flutter, typescript",
  },
  {
    "@type": "SoftwareSourceCode",
    name: SITE_NAME,
    codeRepository: REPOSITORY,
    programmingLanguage: ["TypeScript", "JavaScript", "Dart"],
    runtimePlatform: ["Node.js", "Browser", "Flutter"],
    license,
    author: AUTHOR,
    targetProduct: { "@id": `${home}#software` },
  },
  {
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---
<BaseLayout title="Italian Profanity Filter for JavaScript & Flutter — italian-profanity" description={HOME_DESCRIPTION} jsonLd={jsonLd}>
  <main id="main">
    <Hero />
    <div class="ticker" aria-hidden="true"><div class="ticker-inner"><span>USERNAMES</span><b>✳</b><span>ROOM NAMES</span><b>✳</b><span>TEAM NAMES</span><b>✳</b><span>COMMUNITY INPUT</span><b>✳</b><span>ITALIAN FIRST</span><b>✳</b><span>USERNAMES</span></div></div>
    <Features />
    <Workflows />
    <Installation />
  </main>
  <script>import "../scripts/playground.ts";</script>
</BaseLayout>
