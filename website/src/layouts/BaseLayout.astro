---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import GitHubIcon from "../components/GitHubIcon.astro";

import { absoluteUrl, AUTHOR, REPOSITORY, root, SITE_NAME } from "../data/site";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  /** schema.org nodes for this page, emitted as a single JSON-LD @graph. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, canonicalPath = "", jsonLd = [] } = Astro.props;
const docs = `${root}docs/`;
// Canonical must include the base path (e.g. /italian-profanity/) on GitHub Pages.
const canonical = absoluteUrl(canonicalPath);
const repository = REPOSITORY;
const structuredData = { "@context": "https://schema.org", "@graph": jsonLd };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f8f1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${root}favicon.svg`} type="image/svg+xml" />
    <meta name="author" content={AUTHOR.name} />
    <link rel="sitemap" href={`${root}sitemap.xml`} />
    <link rel="alternate" type="text/plain" title="LLM summary" href={`${root}llms.txt`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell">
      <header class="site-header">
        <div class="shell header-inner">
          <a class="wordmark" href={root} aria-label="italian-profanity home">
            <span class="wordmark-icon" aria-hidden="true">i<span>*</span></span>
            <span>italian-profanity</span>
          </a>
          <nav class="header-links" aria-label="Main navigation">
            <a href={`${root}#playground`}>Playground</a>
            <a href={docs}>Docs</a>
            <a href={`${root}#faq`}>FAQ</a>
            <a class="nav-github" href={repository} target="_blank" rel="noreferrer"><GitHubIcon /> GitHub</a>
          </nav>
        </div>
      </header>

      <slot />

      <footer class="site-footer">
        <div class="shell footer-inner">
          <a class="wordmark footer-mark" href={root}>
            <span class="wordmark-icon" aria-hidden="true">i<span>*</span></span>
            <span>italian-profanity</span>
          </a>
          <nav class="footer-links" aria-label="Footer">
            <a href={docs}>Docs</a>
            <a href="https://www.npmjs.com/package/italian-profanity" target="_blank" rel="noreferrer">npm</a>
            <a href="https://pub.dev/packages/italian_profanity" target="_blank" rel="noreferrer">pub.dev</a>
            <a class="footer-github" href={repository} target="_blank" rel="noreferrer" aria-label="GitHub"><GitHubIcon size={20} /></a>
          </nav>
        </div>
        <div class="shell footer-bottom">
          <span>MIT License</span>
          <span>Made by <a href="https://eliazavatta.it" target="_blank" rel="noreferrer">Elia Zavatta</a></span>
        </div>
      </footer>
    </div>
  </body>
</html>
