---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";

import { absoluteUrl, AUTHOR, NPM_URL, PUB_URL, REPOSITORY, root, SITE_NAME, pageUrl } from "../data/site";
import { LANGS, pageHref, ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Page path without the language prefix: "" (home) or "docs/". */
  pagePath?: string;
  /** schema.org nodes for this page, emitted as a single JSON-LD @graph. */
  jsonLd?: Record<string, unknown>[];
}

const { lang, title, description, pagePath = "", jsonLd = [] } = Astro.props;
const t = ui[lang];
const other: Lang = lang === "en" ? "it" : "en";
const home = pageHref(lang);
const docs = pageHref(lang, "docs/");
// Canonical must include the base path (e.g. /italian-profanity/) on GitHub Pages.
const canonical = pageUrl(lang, pagePath);
const ogImage = absoluteUrl("og.png");
const structuredData = { "@context": "https://schema.org", "@graph": jsonLd };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f8f1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={pageUrl(l, pagePath)} />)}
    <link rel="alternate" hreflang="x-default" href={pageUrl("en", pagePath)} />
    <link rel="icon" href={`${root}favicon.svg`} type="image/svg+xml" />
    <meta name="author" content={AUTHOR.name} />
    <link rel="sitemap" href={`${root}sitemap.xml`} />
    <link rel="alternate" type="text/plain" title="LLM summary" href={`${root}llms.txt`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:locale:alternate" content={ui[other].locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <div class="page-shell">
      <header class="site-header">
        <div class="shell header-inner">
          <Logo href={home} label={t.nav.home} />
          <nav class="header-links" aria-label={t.nav.main}>
            <a href={`${home}#playground`}>{t.nav.playground}</a>
            <a href={docs}>{t.nav.docs}</a>
            <a href={`${home}#faq`}>{t.nav.faq}</a>
            <a class="lang-switch" href={pageHref(other, pagePath)} hreflang={other} lang={other} title={t.switchLang.title}>{t.switchLang.label}</a>
            <a class="nav-github" href={REPOSITORY} target="_blank" rel="noreferrer"><Icon name="github" /> GitHub</a>
          </nav>
        </div>
      </header>

      <slot />

      <footer class="site-footer">
        <div class="shell footer-inner">
          <Logo href={home} label={t.nav.home} />
          <nav class="footer-links" aria-label={t.nav.footer}>
            <a href={docs}>{t.nav.docs}</a>
            <a href={NPM_URL} target="_blank" rel="noreferrer"><Icon name="npm" size={16} /> npm</a>
            <a href={PUB_URL} target="_blank" rel="noreferrer"><Icon name="dart" size={16} /> pub.dev</a>
            <a href={REPOSITORY} target="_blank" rel="noreferrer"><Icon name="github" size={16} /> GitHub</a>
          </nav>
        </div>
        <div class="shell footer-bottom">
          <span>{t.footer.license}</span>
          <span>{t.footer.madeBy} <a href="https://eliazavatta.it" target="_blank" rel="noreferrer">Elia Zavatta</a></span>
        </div>
      </footer>
    </div>
  </body>
</html>
