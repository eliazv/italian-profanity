---
const base = import.meta.env.BASE_URL;
const root = base.endsWith("/") ? base : base + "/";
---
<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="eyebrow-dot"></span> Italian profanity filter · JS &amp; Flutter</p>
    <h1 id="hero-title"><span class="hero-line">GOOD NAMES.</span><br /><span class="hero-outlined">BAD WORDS.</span><br /><span class="hero-stamp">FILTERED.</span></h1>
    <p class="hero-intro">Catches bestemmie, insults and clever misspellings in usernames — without flagging Claudio or Diodato.</p>
    <div class="hero-actions">
      <div class="hero-install">
        <span class="terminal-symbol" aria-hidden="true">$</span>
        <code>npm install italian-profanity</code>
        <button class="copy-button" type="button" data-copy="npm install italian-profanity" aria-label="Copy npm install command">COPY</button>
      </div>
      <a class="button button-dark" href={root + "docs/"}>Read the docs</a>
    </div>
  </div>

  <section class="playground-card" id="playground" aria-labelledby="playground-title">
    <div class="playground-header">
      <h2 class="playground-header-title" id="playground-title"><span class="live-led" aria-hidden="true"></span> Try it</h2>
      <span class="playground-header-meta">Runs in your browser · <span id="demo-version">…</span></span>
    </div>
    <div class="playground-body">
      <textarea id="demo-input" class="demo-input" rows="1" maxlength="120" spellcheck="false" autocomplete="off" aria-label="Nickname or short text" placeholder="Type a nickname…">Claudio</textarea>
      <div class="demo-examples">
        <button type="button" class="example-chip" data-example="Claudio">Claudio</button>
        <button type="button" class="example-chip" data-example="D10 p0rc0">D10 p0rc0</button>
        <button type="button" class="example-chip" data-example="Diodato">Diodato</button>
        <button type="button" class="example-chip" data-example="c a z z o">c a z z o</button>
      </div>
      <div class="playground-controls">
        <select id="demo-profile" class="profile-select" aria-label="Policy">
          <option value="balanced">Balanced policy</option><option value="strict">Strict policy</option><option value="lenient">Lenient policy</option>
        </select>
        <select id="demo-language" class="profile-select" aria-label="Languages">
          <option value="it">Italian</option><option value="it-en">Italian + English</option>
        </select>
      </div>
      <div class="demo-output" aria-live="polite" aria-atomic="true" data-state="loading">
        <div class="output-status">
          <span class="output-icon" id="demo-status-icon" aria-hidden="true">…</span>
          <div class="output-text"><strong id="demo-action">LOADING</strong><p id="demo-explanation">Loading the detector…</p></div>
          <span class="output-count" id="demo-match-count">—</span>
        </div>
        <div class="output-matches" id="demo-matches" hidden></div>
      </div>
    </div>
  </section>
</section>
