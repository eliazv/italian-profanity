---
import Icon from "./Icon.astro";
import DownloadCounter from "./DownloadCounter.astro";
import { pageHref, ui, type Lang } from "../i18n/ui";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="eyebrow-tag">{t.hero.eyebrowTag}</span><span class="eyebrow-text">{t.hero.eyebrow}<span class="eyebrow-extra"> {t.hero.eyebrowExtra}</span></span></p>
    <h1 id="hero-title"><span>{t.hero.line1}</span><br /><span class="hero-outlined">{t.hero.line2}</span><br /><span class="hero-stamp">{t.hero.line3}</span></h1>
    <p class="hero-intro" set:html={t.hero.intro} />
    <div class="hero-actions">
      <div class="hero-install" data-install>
        <div class="install-tabs" role="tablist" aria-label={t.hero.tabs}>
          <button type="button" role="tab" aria-selected="true" data-command="npm install italian-profanity"><Icon name="npm" size={14} /> JavaScript</button>
          <button type="button" role="tab" aria-selected="false" data-command="flutter pub add italian_profanity"><Icon name="dart" size={14} /> Flutter</button>
        </div>
        <div class="install-line">
          <span class="terminal-symbol" aria-hidden="true">$</span>
          <code data-install-code>npm install italian-profanity</code>
          <button class="copy-button" type="button" data-copy="npm install italian-profanity" aria-label={t.copy.copyInstall}>{t.copy.copy}</button>
        </div>
      </div>
      <a class="button button-dark" href={pageHref(lang, "docs/")}>{t.hero.docs}</a>
    </div>
    <DownloadCounter lang={lang} />
  </div>

  <section class="playground-card" id="playground" aria-labelledby="playground-title">
    <div class="playground-header">
      <h2 class="playground-header-title" id="playground-title"><span class="live-led" aria-hidden="true"></span> {t.playground.title}</h2>
      <span class="playground-header-meta">{t.playground.meta}</span>
    </div>
    <div class="playground-body">
      <textarea id="demo-input" class="demo-input" rows="1" maxlength="120" spellcheck="false" autocomplete="off" aria-label={t.playground.input} placeholder={t.playground.placeholder}>Claudio</textarea>
      <div class="demo-examples">
        <button type="button" class="example-chip" data-example="Claudio">Claudio</button>
        <button type="button" class="example-chip" data-example="D10 p0rc0">D10 p0rc0</button>
        <button type="button" class="example-chip" data-example="Diodato">Diodato</button>
        <button type="button" class="example-chip" data-example="c a z z o">c a z z o</button>
      </div>
      <div class="playground-controls">
        <select id="demo-profile" class="profile-select" aria-label={t.playground.policy}>
          <option value="balanced">{t.playground.balanced}</option><option value="strict">{t.playground.strict}</option><option value="lenient">{t.playground.lenient}</option>
        </select>
        <select id="demo-language" class="profile-select" aria-label={t.playground.languages}>
          <option value="it">{t.playground.it}</option><option value="it-en">{t.playground.itEn}</option>
        </select>
      </div>
      <div class="demo-output" aria-live="polite" aria-atomic="true" data-state="loading">
        <div class="output-status">
          <span class="output-icon" id="demo-status-icon" aria-hidden="true">…</span>
          <div class="output-text"><strong id="demo-action">{t.playground.loading}</strong><p id="demo-explanation">{t.playground.loadingText}</p></div>
          <span class="output-count" id="demo-match-count">—</span>
        </div>
        <div class="output-matches" id="demo-matches" hidden></div>
      </div>
    </div>
  </section>
</section>

<script>
  // Install tabs: swap the command shown and copied.
  document.querySelectorAll<HTMLElement>("[data-install]").forEach((box) => {
    const code = box.querySelector<HTMLElement>("[data-install-code]");
    const copy = box.querySelector<HTMLButtonElement>("[data-copy]");
    const tabs = box.querySelectorAll<HTMLButtonElement>("[role=tab]");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const command = tab.dataset.command ?? "";
        tabs.forEach((other) => other.setAttribute("aria-selected", String(other === tab)));
        if (code) code.textContent = command;
        if (copy) copy.dataset.copy = command;
      });
    });
  });
</script>
