---
import Faq from "./Faq.astro";
import Icon from "./Icon.astro";
const base = import.meta.env.BASE_URL;
const docs = (base.endsWith("/") ? base : base + "/") + "docs/";
const jsExample = [
  'import { createChecker } from "italian-profanity";',
  '',
  'const checker = createChecker({ profile: "balanced" });',
  'checker.check("D10 p0rc0").action; // "block"',
  'checker.check("Claudio").action;  // "allow"',
].join("\n");
const dartExample = [
  "import 'package:italian_profanity/italian_profanity.dart';",
  "",
  "final checker = ItalianProfanity.createChecker();",
  "checker.check('D10 p0rc0').action; // Action.block",
].join("\n");
---
<section class="section shell" id="install" aria-labelledby="install-title">
  <div class="section-heading split-heading">
    <div><span class="section-index">03 / GET STARTED</span><h2 id="install-title">READY IN<br /><em>A FEW LINES.</em></h2></div>
    <p>No API key, no network calls, no service to maintain.</p>
  </div>
  <div class="code-grid">
    <article class="code-card">
      <div class="code-card-header"><div><span class="code-dot dot-lime"></span><strong>JAVASCRIPT / TYPESCRIPT</strong></div><a class="registry-link" href="https://www.npmjs.com/package/italian-profanity" target="_blank" rel="noreferrer"><Icon name="npm" size={14} /> npm</a></div>
      <div class="code-command"><span>$</span><code>npm install italian-profanity</code><button type="button" data-copy="npm install italian-profanity" aria-label="Copy npm command">COPY</button></div>
      <pre><code>{jsExample}</code></pre>
    </article>
    <article class="code-card">
      <div class="code-card-header"><div><span class="code-dot dot-pink"></span><strong>DART / FLUTTER</strong></div><a class="registry-link" href="https://pub.dev/packages/italian_profanity" target="_blank" rel="noreferrer"><Icon name="dart" size={14} /> pub.dev</a></div>
      <div class="code-command"><span>$</span><code>flutter pub add italian_profanity</code><button type="button" data-copy="flutter pub add italian_profanity" aria-label="Copy Flutter command">COPY</button></div>
      <pre><code>{dartExample}</code></pre>
    </article>
  </div>
</section>
<Faq />
<section class="final-cta shell">
  <div class="final-cta-inner">
    <h2>LET'S KEEP THE<br /><span>GOOD NAMES.</span></h2>
    <p>Free, MIT licensed and open to contributions.</p>
    <div class="final-actions">
      <a href="https://github.com/eliazv/italian-profanity" target="_blank" rel="noreferrer" class="button button-lime"><Icon name="github" /> Star on GitHub</a>
      <a href={docs} class="button button-outline-light">Read the docs</a>
    </div>
  </div>
</section>
