---
import { faq } from "../data/faq";
---
<section class="section shell" id="faq" aria-labelledby="faq-title">
  <div class="section-heading split-heading">
    <div><span class="section-index">04 / FAQ</span><h2 id="faq-title">QUESTIONS,<br /><em>ANSWERED.</em></h2></div>
    <p>What developers usually ask before adding an Italian profanity filter to a signup form.</p>
  </div>
  <div class="faq-list">
    {faq.map((item, index) => (
      <details class="faq-item" open={index === 0}>
        <summary><h3>{item.question}</h3></summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>
