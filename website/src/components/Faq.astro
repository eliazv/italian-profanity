---
import { faq } from "../data/faq";
---
<section class="section shell" id="faq" aria-labelledby="faq-title">
  <div class="section-heading">
    <div><h2 id="faq-title">QUESTIONS,<br /><em>ANSWERED.</em></h2></div>
  </div>
  <div class="faq-list">
    {faq.map((item, index) => (
      <details class="faq-item" open={index === 0}>
        <summary><h3>{item.question}</h3></summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>
