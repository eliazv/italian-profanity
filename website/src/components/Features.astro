---
import { ui, type Lang } from "../i18n/ui";
interface Props { lang: Lang }
const t = ui[Astro.props.lang].features;
const [evasions, names, parity] = t.cards;
---
<section class="section shell" id="why" aria-labelledby="why-title">
  <div class="section-heading">
    <h2 id="why-title" set:html={t.title} />
  </div>
  <div class="feature-grid">
    <article class="feature-card feature-yellow">
      <div class="feature-top"><span>01</span><span class="feature-glyph" aria-hidden="true">↗</span></div>
      <div class="feature-example">p0rc0</div>
      <h3>{evasions.title}</h3>
      <p>{evasions.text}</p>
    </article>
    <article class="feature-card feature-pink">
      <div class="feature-top"><span>02</span><span class="feature-glyph" aria-hidden="true">◎</span></div>
      <div class="feature-example feature-name">Claudio <span class="feature-allowed">✓</span></div>
      <h3>{names.title}</h3>
      <p>{names.text}</p>
    </article>
    <article class="feature-card feature-lilac">
      <div class="feature-top"><span>03</span><span class="feature-glyph" aria-hidden="true">✳</span></div>
      <div class="feature-example feature-pair">JS <span aria-hidden="true">↔</span> DART</div>
      <h3>{parity.title}</h3>
      <p>{parity.text}</p>
    </article>
  </div>
</section>
